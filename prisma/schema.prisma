

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "strictUndefinedChecks"]
  output          = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}


// ENUMS


enum UserRole {
  INVESTOR
  TRADER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  // Note: email verification is handled by Clerk.
  // This status reflects your platform's internal state.
  ONBOARDING      // signed up but hasn't completed profile/KYC
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum AccountType {
  CASH
  MARGIN
  RETIREMENT    // e.g. IRA
  DEMO          // paper trading
}

enum AccountStatus {
  ACTIVE
  RESTRICTED    // e.g. pattern day trader warning
  FROZEN
  CLOSED
}

enum OrderSide {
  BUY
  SELL
  SELL_SHORT
  BUY_TO_COVER
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_LIMIT
  TRAILING_STOP
  OCO           // One Cancels Other
  BRACKET
}

enum OrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

enum OrderDuration {
  DAY
  GTC           // Good Till Cancelled
  IOC           // Immediate or Cancel
  FOK           // Fill or Kill
  GTD           // Good Till Date
  EXT           // Extended Hours
}

enum PositionSide {
  LONG
  SHORT
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRADE_BUY
  TRADE_SELL
  DIVIDEND
  INTEREST
  FEE
  TAX
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum AssetClass {
  EQUITY
  ETF
  OPTION
  FUTURE
  FOREX
  CRYPTO
  BOND
  MUTUAL_FUND
  INDEX
}

enum MarketStatus {
  PRE_MARKET
  OPEN
  POST_MARKET
  CLOSED
  HALTED
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  PERCENT_CHANGE
  VOLUME_SPIKE
  NEWS
  EARNINGS
  DIVIDEND
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  EXPIRED
  CANCELLED
}

enum NotificationType {
  ORDER_FILLED
  ORDER_REJECTED
  PRICE_ALERT
  DEPOSIT_CONFIRMED
  WITHDRAWAL_PROCESSED
  KYC_STATUS_CHANGE
  SYSTEM_ANNOUNCEMENT
  MARGIN_CALL
  ACCOUNT_ACTIVITY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum WatchlistVisibility {
  PRIVATE
  PUBLIC
}

enum OptionType {
  CALL
  PUT
}

enum PaymentMethod {
  BANK_TRANSFER
  WIRE
  ACH
  CARD
  UPI
  CRYPTO
}

enum RiskLevel {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
  SPECULATIVE
}


// USER

// Clerk owns: passwords, email/phone verification, OAuth accounts,
// sessions, devices, MFA (TOTP + backup codes), login history.
//
// This model stores only what YOUR application owns.
// The primary key is your internal DB id (cuid).
// clerkId is the stable Clerk user ID ("user_xxxxx") used to
// link Clerk webhook events and session tokens to this record.


model User {
  id           String     @id @default(cuid())
  clerkId      String     @unique // Clerk user ID — never changes
  email        String     @unique // synced from Clerk via webhook
  phone        String?    @unique // synced from Clerk via webhook
  firstName    String
  lastName     String
  avatarUrl    String?    // synced from Clerk (imageUrl)
  role         UserRole   @default(INVESTOR)
  status       UserStatus @default(ONBOARDING)
  timezone     String     @default("Asia/Kolkata")
  locale       String     @default("en-IN")
  referralCode String     @unique @default(cuid())
  referredById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?  // soft delete (also ban in Clerk on delete)

  // Relations
  referredBy           User?                    @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]                   @relation("Referrals")
  profile              UserProfile?
  kycRecord            KYCRecord?
  riskProfile          RiskProfile?
  tradingAccounts      TradingAccount[]
  watchlists           Watchlist[]
  alerts               PriceAlert[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  apiKeys              ApiKey[]
  bankAccounts         BankAccount[]
  auditLogs            AuditLog[]

  @@index([clerkId])
  @@index([email])
  @@index([status])
  @@index([referredById])
  @@map("users")
}


// USER PROFILE
// Business/compliance data YOUR platform collects post-signup.
// Not available in Clerk — stored here.


model UserProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  dateOfBirth     DateTime?
  bio             String?
  country         String?
  state           String?
  city            String?
  address         String?
  postalCode      String?
  nationality     String?
  taxId           String?   // PAN / SSN — store encrypted
  occupation      String?
  annualIncome    Decimal?  @db.Decimal(18, 2)
  netWorth        Decimal?  @db.Decimal(18, 2)
  investmentGoals String[]
  onboardingStep  Int       @default(0) // track funnel progress
  onboardingDoneAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}


// API KEYS  (programmatic access — separate from Clerk sessions)
// Clerk manages browser/mobile sessions. These keys are for
// server-to-server or algorithmic trading integrations.


model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyHash     String    @unique   // store SHA-256 hash only
  keyPrefix   String              // first 8 chars shown in UI
  permissions String[]            // ["read:portfolio","write:orders"]
  ipWhitelist String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}


// KYC / AML


model KYCRecord {
  id              String     @id @default(cuid())
  userId          String     @unique
  status          KYCStatus  @default(NOT_SUBMITTED)
  level           Int        @default(1)  // 1=basic, 2=enhanced, 3=full
  submittedAt     DateTime?
  reviewedAt      DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  expiresAt       DateTime?
  rejectionReason String?
  reviewedBy      String?    // admin userId
  providerRef     String?    // external KYC provider reference ID
  riskScore       Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       KYCDocument[]

  @@map("kyc_records")
}

model KYCDocument {
  id          String    @id @default(cuid())
  kycRecordId String
  docType     String    // "passport"|"national_id"|"driving_license"|"utility_bill"
  docNumber   String?
  fileUrl     String    // encrypted S3 presigned URL
  fileHash    String    // SHA-256 for integrity verification
  mimeType    String
  issuedAt    DateTime?
  expiresAt   DateTime?
  verifiedAt  DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())

  kycRecord   KYCRecord @relation(fields: [kycRecordId], references: [id], onDelete: Cascade)

  @@index([kycRecordId])
  @@map("kyc_documents")
}


// RISK PROFILE


model RiskProfile {
  id                  String     @id @default(cuid())
  userId              String     @unique
  riskLevel           RiskLevel  @default(MODERATE)
  score               Int        @default(50) // 0–100
  maxPositionSize     Decimal    @db.Decimal(5, 2)  // % of portfolio
  maxDailyLoss        Decimal    @db.Decimal(5, 2)  // % of portfolio
  allowedAssets       AssetClass[]
  marginEnabled       Boolean    @default(false)
  shortSellingAllowed Boolean    @default(false)
  optionsLevel        Int        @default(0) // 0=none,1=covered,2=spreads,3=naked
  assessedAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("risk_profiles")
}


// TRADING ACCOUNTS & PORTFOLIO


model TradingAccount {
  id                  String        @id @default(cuid())
  userId              String
  accountNumber       String        @unique
  type                AccountType   @default(CASH)
  status              AccountStatus @default(ACTIVE)
  currency            String        @default("INR")
  cashBalance         Decimal       @db.Decimal(20, 4) @default(0)
  buyingPower         Decimal       @db.Decimal(20, 4) @default(0)
  marginBalance       Decimal       @db.Decimal(20, 4) @default(0)
  marginUsed          Decimal       @db.Decimal(20, 4) @default(0)
  maintenanceMargin   Decimal       @db.Decimal(20, 4) @default(0)
  totalPortfolioValue Decimal       @db.Decimal(20, 4) @default(0)
  dayPnl              Decimal       @db.Decimal(20, 4) @default(0)
  totalPnl            Decimal       @db.Decimal(20, 4) @default(0)
  isDefault           Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  closedAt            DateTime?

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions           Position[]
  orders              Order[]
  transactions        Transaction[]
  portfolioSnapshots  PortfolioSnapshot[]

  @@index([userId])
  @@index([accountNumber])
  @@map("trading_accounts")
}

model Position {
  id               String         @id @default(cuid())
  accountId        String
  symbolId         String
  side             PositionSide   @default(LONG)
  quantity         Decimal        @db.Decimal(18, 6)
  avgCostBasis     Decimal        @db.Decimal(18, 6)
  currentPrice     Decimal        @db.Decimal(18, 6)
  marketValue      Decimal        @db.Decimal(20, 4)
  unrealizedPnl    Decimal        @db.Decimal(20, 4)
  unrealizedPnlPct Decimal        @db.Decimal(8, 4)
  realizedPnl      Decimal        @db.Decimal(20, 4) @default(0)
  dayPnl           Decimal        @db.Decimal(20, 4) @default(0)
  openedAt         DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  account          TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol           Symbol         @relation(fields: [symbolId], references: [id])

  @@unique([accountId, symbolId, side])
  @@index([accountId])
  @@index([symbolId])
  @@map("positions")
}

model PortfolioSnapshot {
  id            String         @id @default(cuid())
  accountId     String
  totalValue    Decimal        @db.Decimal(20, 4)
  cashBalance   Decimal        @db.Decimal(20, 4)
  investedValue Decimal        @db.Decimal(20, 4)
  dayReturn     Decimal        @db.Decimal(20, 4)
  totalReturn   Decimal        @db.Decimal(20, 4)
  snapshotAt    DateTime       @default(now())

  account       TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([snapshotAt])
  @@map("portfolio_snapshots")
}


// MARKET DATA


model Exchange {
  id         String       @id @default(cuid())
  code       String       @unique  // "NSE"|"BSE"|"NYSE"|"NASDAQ"
  name       String
  country    String
  currency   String
  timezone   String
  openTime   String       // "09:15"
  closeTime  String       // "15:30"
  website    String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  symbols    Symbol[]
  marketHours MarketHour[]

  @@map("exchanges")
}

model MarketHour {
  id          String   @id @default(cuid())
  exchangeId  String
  dayOfWeek   Int      // 0=Sunday … 6=Saturday
  openTime    String
  closeTime   String
  isHoliday   Boolean  @default(false)
  holidayDate DateTime?
  note        String?

  exchange    Exchange @relation(fields: [exchangeId], references: [id])

  @@index([exchangeId])
  @@map("market_hours")
}

model Symbol {
  id           String     @id @default(cuid())
  ticker       String
  exchangeId   String
  name         String
  fullName     String?
  assetClass   AssetClass @default(EQUITY)
  currency     String     @default("INR")
  isin         String?    @unique
  cusip        String?
  faceValue    Decimal?   @db.Decimal(18, 4)
  lotSize      Int        @default(1)
  tickSize     Decimal    @db.Decimal(18, 6) @default(0.05)
  sector       String?
  industry     String?
  marketCap    Decimal?   @db.Decimal(24, 2)
  isActive     Boolean    @default(true)
  isTradable   Boolean    @default(true)
  isShortable  Boolean    @default(false)
  marginable   Boolean    @default(false)
  underlyingId String?    // for options / futures
  logoUrl      String?
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  exchange       Exchange         @relation(fields: [exchangeId], references: [id])
  underlying     Symbol?          @relation("Derivatives", fields: [underlyingId], references: [id])
  derivatives    Symbol[]         @relation("Derivatives")
  quote          Quote?
  ohlcvData      OHLCV[]
  positions      Position[]
  orders         Order[]
  watchlistItems WatchlistItem[]
  alerts         PriceAlert[]
  optionChain    OptionContract[]
  fundamentals   Fundamentals?
  dividends      Dividend[]
  splits         StockSplit[]

  @@unique([ticker, exchangeId])
  @@index([ticker])
  @@index([assetClass])
  @@index([sector])
  @@map("symbols")
}

model Quote {
  id            String      @id @default(cuid())
  symbolId      String      @unique
  open          Decimal     @db.Decimal(18, 6)
  high          Decimal     @db.Decimal(18, 6)
  low           Decimal     @db.Decimal(18, 6)
  close         Decimal     @db.Decimal(18, 6)
  previousClose Decimal     @db.Decimal(18, 6)
  lastPrice     Decimal     @db.Decimal(18, 6)
  bidPrice      Decimal?    @db.Decimal(18, 6)
  askPrice      Decimal?    @db.Decimal(18, 6)
  bidSize       Int?
  askSize       Int?
  volume        BigInt
  avgVolume     BigInt?
  change        Decimal     @db.Decimal(18, 6)
  changePct     Decimal     @db.Decimal(8, 4)
  weekHigh52    Decimal?    @db.Decimal(18, 6)
  weekLow52     Decimal?    @db.Decimal(18, 6)
  marketStatus  MarketStatus @default(CLOSED)
  tradedAt      DateTime
  updatedAt     DateTime    @updatedAt

  symbol        Symbol      @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@map("quotes")
}

model OHLCV {
  id        String   @id @default(cuid())
  symbolId  String
  interval  String   // "1m"|"5m"|"15m"|"1h"|"1d"|"1w"|"1mo"
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    BigInt
  timestamp DateTime

  symbol    Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([symbolId, interval, timestamp])
  @@index([symbolId, interval])
  @@index([timestamp])
  @@map("ohlcv")
}

model Fundamentals {
  id               String   @id @default(cuid())
  symbolId         String   @unique
  peRatio          Decimal? @db.Decimal(10, 4)
  pbRatio          Decimal? @db.Decimal(10, 4)
  psRatio          Decimal? @db.Decimal(10, 4)
  evEbitda         Decimal? @db.Decimal(10, 4)
  eps              Decimal? @db.Decimal(18, 4)
  epsGrowthYoy     Decimal? @db.Decimal(8, 4)
  revenue          Decimal? @db.Decimal(24, 2)
  revenueGrowthYoy Decimal? @db.Decimal(8, 4)
  netIncome        Decimal? @db.Decimal(24, 2)
  grossMargin      Decimal? @db.Decimal(8, 4)
  netMargin        Decimal? @db.Decimal(8, 4)
  roe              Decimal? @db.Decimal(8, 4)
  roa              Decimal? @db.Decimal(8, 4)
  debtToEquity     Decimal? @db.Decimal(10, 4)
  currentRatio     Decimal? @db.Decimal(10, 4)
  dividendYield    Decimal? @db.Decimal(8, 4)
  beta             Decimal? @db.Decimal(8, 4)
  reportedAt       DateTime?
  updatedAt        DateTime @updatedAt

  symbol           Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@map("fundamentals")
}

model Dividend {
  id             String   @id @default(cuid())
  symbolId       String
  amount         Decimal  @db.Decimal(18, 6)
  currency       String   @default("INR")
  exDividendDate DateTime
  paymentDate    DateTime?
  recordDate     DateTime?
  frequency      String?  // "quarterly"|"annual"|"special"
  createdAt      DateTime @default(now())

  symbol         Symbol   @relation(fields: [symbolId], references: [id])

  @@index([symbolId])
  @@map("dividends")
}

model StockSplit {
  id        String   @id @default(cuid())
  symbolId  String
  ratio     Decimal  @db.Decimal(10, 4) // e.g. 2.0 = 2:1 split
  splitDate DateTime
  createdAt DateTime @default(now())

  symbol    Symbol   @relation(fields: [symbolId], references: [id])

  @@index([symbolId])
  @@map("stock_splits")
}

model OptionContract {
  id             String     @id @default(cuid())
  symbolId       String     // underlying symbol
  contractSymbol String     @unique
  optionType     OptionType
  strikePrice    Decimal    @db.Decimal(18, 4)
  expirationDate DateTime
  lotSize        Int        @default(100)
  openInterest   BigInt?
  impliedVol     Decimal?   @db.Decimal(8, 4)
  delta          Decimal?   @db.Decimal(8, 6)
  gamma          Decimal?   @db.Decimal(8, 6)
  theta          Decimal?   @db.Decimal(8, 6)
  vega           Decimal?   @db.Decimal(8, 6)
  rho            Decimal?   @db.Decimal(8, 6)
  lastPrice      Decimal?   @db.Decimal(18, 4)
  bid            Decimal?   @db.Decimal(18, 4)
  ask            Decimal?   @db.Decimal(18, 4)
  volume         BigInt?
  updatedAt      DateTime   @updatedAt

  symbol         Symbol     @relation(fields: [symbolId], references: [id])

  @@index([symbolId, optionType, expirationDate])
  @@map("option_contracts")
}


// ORDERS


model Order {
  id                String        @id @default(cuid())
  accountId         String
  symbolId          String
  clientOrderId     String?       @unique  // idempotency key from client
  side              OrderSide
  type              OrderType
  status            OrderStatus   @default(PENDING)
  duration          OrderDuration @default(DAY)
  quantity          Decimal       @db.Decimal(18, 6)
  filledQuantity    Decimal       @db.Decimal(18, 6) @default(0)
  remainingQuantity Decimal       @db.Decimal(18, 6)
  limitPrice        Decimal?      @db.Decimal(18, 6)
  stopPrice         Decimal?      @db.Decimal(18, 6)
  trailAmount       Decimal?      @db.Decimal(18, 6)
  trailPercent      Decimal?      @db.Decimal(8, 4)
  avgFillPrice      Decimal?      @db.Decimal(18, 6)
  estimatedAmount   Decimal?      @db.Decimal(20, 4)
  filledAmount      Decimal?      @db.Decimal(20, 4)
  commission        Decimal       @db.Decimal(18, 4) @default(0)
  tax               Decimal       @db.Decimal(18, 4) @default(0)
  otherCharges      Decimal       @db.Decimal(18, 4) @default(0)
  netAmount         Decimal?      @db.Decimal(20, 4)
  extendedHours     Boolean       @default(false)
  notes             String?
  rejectionReason   String?
  expiresAt         DateTime?     // for GTD orders
  submittedAt       DateTime      @default(now())
  filledAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // OCO / Bracket link
  linkedOrderId     String?
  linkedOrder       Order?         @relation("LinkedOrders", fields: [linkedOrderId], references: [id])
  linkedOrders      Order[]        @relation("LinkedOrders")

  account           TradingAccount @relation(fields: [accountId], references: [id])
  symbol            Symbol         @relation(fields: [symbolId], references: [id])
  fills             OrderFill[]

  @@index([accountId])
  @@index([symbolId])
  @@index([status])
  @@index([submittedAt])
  @@map("orders")
}

model OrderFill {
  id          String   @id @default(cuid())
  orderId     String
  quantity    Decimal  @db.Decimal(18, 6)
  price       Decimal  @db.Decimal(18, 6)
  commission  Decimal  @db.Decimal(18, 4) @default(0)
  tax         Decimal  @db.Decimal(18, 4) @default(0)
  executionId String?  // exchange execution reference
  filledAt    DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_fills")
}


// TRANSACTIONS & LEDGER


model Transaction {
  id            String            @id @default(cuid())
  accountId     String
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  currency      String            @default("INR")
  amount        Decimal           @db.Decimal(20, 4)
  fee           Decimal           @db.Decimal(18, 4) @default(0)
  tax           Decimal           @db.Decimal(18, 4) @default(0)
  netAmount     Decimal           @db.Decimal(20, 4)
  balanceBefore Decimal           @db.Decimal(20, 4)
  balanceAfter  Decimal           @db.Decimal(20, 4)
  description   String?
  referenceId   String?           // order ID / transfer ID
  externalRef   String?           // bank ref / payment gateway ID
  paymentMethod PaymentMethod?
  metadata      Json?
  processedAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  account       TradingAccount    @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}


// BANK ACCOUNTS & PAYMENTS


model BankAccount {
  id            String    @id @default(cuid())
  userId        String
  accountHolder String
  bankName      String
  accountNumber String    // store encrypted
  ifscCode      String?   // India
  routingNumber String?   // USA
  accountType   String    // "savings"|"checking"|"current"
  currency      String    @default("INR")
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  isPrimary     Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bank_accounts")
}


// WATCHLISTS & ALERTS


model Watchlist {
  id          String              @id @default(cuid())
  userId      String
  name        String
  description String?
  visibility  WatchlistVisibility @default(PRIVATE)
  isDefault   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  symbolId    String
  sortOrder   Int       @default(0)
  notes       String?
  addedAt     DateTime  @default(now())

  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol      Symbol    @relation(fields: [symbolId], references: [id])

  @@unique([watchlistId, symbolId])
  @@index([watchlistId])
  @@map("watchlist_items")
}

model PriceAlert {
  id          String      @id @default(cuid())
  userId      String
  symbolId    String
  type        AlertType
  status      AlertStatus @default(ACTIVE)
  targetValue Decimal     @db.Decimal(18, 6)
  message     String?
  triggeredAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      Symbol      @relation(fields: [symbolId], references: [id])

  @@index([userId])
  @@index([symbolId, status])
  @@map("price_alerts")
}


// NOTIFICATIONS


model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  data      Json?               // extra payload
  isRead    Boolean             @default(false)
  readAt    DateTime?
  sentAt    DateTime?
  failedAt  DateTime?
  createdAt DateTime            @default(now())

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  type      NotificationType
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@map("notification_preferences")
}


// AUDIT & COMPLIANCE


model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  // null for system-generated events
  // clerkSessionId lets you correlate an action to the exact
  // Clerk session that performed it (from auth().sessionId).
  clerkSessionId String?
  action     String   // "ORDER_PLACED"|"WITHDRAWAL_REQUESTED"|"KYC_APPROVED"
  resource   String   // "Order"|"TradingAccount"|...
  resourceId String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clerkSessionId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
