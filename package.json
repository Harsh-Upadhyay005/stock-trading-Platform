    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.24.0",
    "next": "^16.2.7",
    "pino": "^10.3.1",
    "postcss": "^8.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "svix": "^1.96.0",
    "tailwind-merge": "^3.6.0",
